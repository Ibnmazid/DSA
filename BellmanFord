#include <iostream>
#include <vector>
#include <climits>

using namespace std;

struct Edge
{
    int u, v, weight;
};

void bellmanFord(int V,
                 vector<Edge>& edges,
                 int source)
{
    vector<int> dist(V, INT_MAX);

    dist[source] = 0;

    // Relax V-1 times
    for(int i = 1; i <= V - 1; i++)
    {
        for(auto edge : edges)
        {
            int u = edge.u;
            int v = edge.v;
            int w = edge.weight;

            if(dist[u] != INT_MAX &&
               dist[u] + w < dist[v])
            {
                dist[v] = dist[u] + w;
            }
        }
    }

    // Check Negative Cycle
    bool negativeCycle = false;

    for(auto edge : edges)
    {
        int u = edge.u;
        int v = edge.v;
        int w = edge.weight;

        if(dist[u] != INT_MAX &&
           dist[u] + w < dist[v])
        {
            negativeCycle = true;
            break;
        }
    }

    if(negativeCycle)
    {
        cout << "Negative Weight Cycle Found\n";
        return;
    }

    cout << "Shortest Distances:\n";

    for(int i = 0; i < V; i++)
    {
        cout << i
             << " : "
             << dist[i]
             << endl;
    }
}

int main()
{
    int V, E;

    cin >> V >> E;

    vector<Edge> edges;

    for(int i = 0; i < E; i++)
    {
        Edge e;

        cin >> e.u
            >> e.v
            >> e.weight;

        edges.push_back(e);
    }

    int source;

    cin >> source;

    bellmanFord(V, edges, source);

    return 0;
}
