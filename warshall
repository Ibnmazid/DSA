#include <iostream>
#include <vector>
using namespace std;

#define INF 99999

void floydWarshall(vector<vector<int>>& dist, int V)
{
    for(int k = 0; k < V; k++)
    {
        for(int i = 0; i < V; i++)
        {
            for(int j = 0; j < V; j++)
            {
                if(dist[i][k] != INF &&
                   dist[k][j] != INF &&
                   dist[i][k] + dist[k][j]
                   < dist[i][j])
                {
                    dist[i][j] =
                    dist[i][k] + dist[k][j];
                }
            }
        }
    }

    cout << "\nShortest Path Matrix:\n";

    for(int i = 0; i < V; i++)
    {
        for(int j = 0; j < V; j++)
        {
            if(dist[i][j] == INF)
                cout << "INF ";
            else
                cout << dist[i][j] << " ";
        }
        cout << endl;
    }
}

int main()
{
    int V;

    cin >> V;

    vector<vector<int>> dist(
        V,
        vector<int>(V)
    );

    for(int i = 0; i < V; i++)
    {
        for(int j = 0; j < V; j++)
        {
            cin >> dist[i][j];
        }
    }

    floydWarshall(dist, V);

    return 0;
}
