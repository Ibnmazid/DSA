#include <iostream>
using namespace std;

void display(string arr[], int n)
{
    for(int i=0; i<n; i++)
        cout << arr[i] << " ";

    cout << endl;
}

void insertion(string arr[], int &n, string item)
{
    int pos = 0;

    // Find correct position
    while(pos < n && arr[pos] < item)
        pos++;

    // Shift right
    for(int i=n; i>pos; i--)
        arr[i] = arr[i-1];

    arr[pos] = item;
    n++;
}

void deletion(string arr[], int &n, string item)
{
    int pos = -1;

    // Search item
    for(int i=0; i<n; i++)
    {
        if(arr[i] == item)
        {
            pos = i;
            break;
        }
    }

    if(pos == -1)
    {
        cout << "Item not found\n";
        return;
    }

    // Shift left
    for(int i=pos; i<n-1; i++)
        arr[i] = arr[i+1];

    n--;
}

int main()
{
    string arr[20]={"BBBB","DDDD","MMMM","XXXX"};
    int n=4;

    cout<<"Initial Array:\n";
    display(arr,n);

    insertion(arr,n,"FFFF");
    insertion(arr,n,"ZZZZ");

    cout<<"\nAfter Insertion:\n";
    display(arr,n);

    deletion(arr,n,"MMMM");

    cout<<"\nAfter Deletion:\n";
    display(arr,n);

    return 0;
}
