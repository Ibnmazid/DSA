#include <iostream>
#include <vector>
#include <stack>
using namespace std;

void dfs(int start, vector<int> adj[], int N)
{
    vector<bool> visited(N, false);

    stack<int> st;

    st.push(start);

    while(!st.empty())
    {
        int node = st.top();
        st.pop();

        if(visited[node])
            continue;

        visited[node] = true;

        cout << node << " ";

        for(int i = adj[node].size()-1; i >= 0; i--)
        {
            int neighbour = adj[node][i];

            if(!visited[neighbour])
                st.push(neighbour);
        }
    }
}

int main()
{
    int N, M;

    cin >> N >> M;

    vector<int> adj[N];

    for(int i=0; i<M; i++)
    {
        int u,v;

        cin >> u >> v;

        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    int start;
    cin >> start;

    dfs(start, adj, N);
}
